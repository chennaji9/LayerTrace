# LayerTrace 控制面环境变量样例
# 复制为 .env 并按环境修改。敏感值不得提交到仓库。

# 运行模式：prod（默认，关闭实验写通道）| lab（授权实验）| replay
MODE=prod
LAB_ENABLED=false

# 范围标识（单租户单项目）
TENANT_ID=00000000-0000-0000-0000-000000000001
PROJECT_ID=00000000-0000-0000-0000-000000000001
INSTANCE_NAME=layertrace-control-plane

# PostgreSQL（事实存储）
# 用 scripts/configure_local_env.py 生成同步密码和URL；不要使用固定默认密码。
POSTGRES_PASSWORD=
DATABASE_URL=
GRAFANA_ADMIN_PASSWORD=

# Prometheus / Grafana / Tempo
PROMETHEUS_URL=http://localhost:9090
# GRAFANA_URL=http://localhost:3000
# GRAFANA_PORT=3000
# TEMPO_URL=http://localhost:3200

# ZSvirt 只读平台连接（未配置时状态页显示 not_configured）
ZSVIRT_ENABLED=false
# ZSVIRT_BASE_URL=https://zsvirt.example.com
# ZSVIRT_TOKEN=（只读凭证，禁止入库/入仓/入日志）
# ZSVIRT_ACCOUNT_NAME=layertrace-observer
# ZSVIRT_PASSWORD_HASH=（只读账户密码的 SHA-512 十六进制值，禁止入库/入仓/入日志）
# 同时设置账户名与密码哈希时，明确 session 过期后自动登录并重试读取一次。
# 仅提供 TOKEN 时过期会显示 permission_denied / session_expired，需人工更换。
# ZSVIRT_CA_PATH=/etc/layertrace/ca/zsvirt-ca.crt
ZSVIRT_VERIFY_HOSTNAME=true
ZSVIRT_PROVIDER_INSTANCE=zsvirt-lab

# 传输安全：仅信任来自这些地址的转发头（Caddy 部署网段）
TRUSTED_PROXIES=172.31.255.0/24
REQUIRE_TLS_OFF_LOOPBACK=true
# 仅供 loopback 端口经容器 DNAT 的固定网关；非 Compose 部署保持为空
PLAINTEXT_CLIENT_CIDRS=

# 保留期（天）：指标 7 / Span 3 / 事件与诊断 30
RETENTION_METRICS_DAYS=7
RETENTION_SPAN_DAYS=3
RETENTION_EVENT_DAYS=30
RETENTION_DIAGNOSIS_DAYS=30

# 采集状态
HEARTBEAT_INTERVAL_SECONDS=15
STALE_AFTER_MISSED_HEARTBEATS=3

# 告警轮询与恢复稳定窗口
ALERT_POLL_SECONDS=15
INCIDENT_RECOVERY_STABLE_SECONDS=60

# 延迟基线（R2/R4/Agent 共用）
BASELINE_WINDOW_SECONDS=900
BASELINE_MIN_SAMPLES=30

# 认证（生产必须替换为强随机值；逗号分隔多个 token）
API_TOKENS=
# 浏览器签名会话从API_TOKENS派生；会话12小时，无单独SESSION_SECRET。
PROBE_REGISTRATION_SECRET=
PROBE_TOKEN_TTL_SECONDS=600

# 可选组件
NOTIFICATION_SINK_ENABLED=false
# NOTIFICATION_SINK_URL=

# Web：HTTP 仅绑定 loopback，跨主机入口走 Caddy TLS
WEB_HOST=127.0.0.1
WEB_PORT=8000
