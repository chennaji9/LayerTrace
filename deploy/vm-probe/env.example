# Copy to a protected local file, chmod 600. Do not commit actual credentials.
LAYERTRACE_API=https://layertrace.example.internal
PROBE_INSTALLATION_ID=replace-with-persistent-installation-uuid
PROBE_VM_EXTERNAL_ID=replace-with-real-zsvirt-vm-uuid
PROBE_REGISTRATION_SECRET=replace-with-secret-from-control-plane
LAYERTRACE_TOKEN=replace-with-project-write-token
LAYERTRACE_MODEL_DIRECTORY=/opt/layertrace-assets
# If using a private CA: mount its directory, then set the path inside the container.
LAYERTRACE_CA_DIRECTORY=./certs
LAYERTRACE_CA_FILE=/certs/layertrace-ca.crt
# Explicit reachable guest IP for Prometheus, firewall-restricted to control plane.
PROBE_METRICS_BIND=127.0.0.1
MODEL_THREADS=1
MODEL_TIMEOUT_SECONDS=45
CLIENT_TIMEOUT_SECONDS=100
LOAD_INTERVAL_SECONDS=2
