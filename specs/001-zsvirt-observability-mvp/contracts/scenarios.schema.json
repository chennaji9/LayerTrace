{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layertrace.local/schemas/scenario-1.0.json",
  "title": "LayerTrace Scenario 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "kind", "description", "topology", "events", "expected_assertions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "kind": { "type": "string", "enum": ["replay", "fault"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900, "default": 180 },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128 }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources", "relationships"],
      "properties": {
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        }
      }
    },
    "metric_fragments": {
      "type": "array",
      "items": { "$ref": "#/$defs/metricFragment" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "events.schema.json#/$defs/event" }
    },
    "inject": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "restore": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "expected_assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    }
  },
  "$defs": {
    "offset": { "type": "string", "pattern": "^\\+[0-9]+(ms|s|m)$" },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "provider", "source_id", "provenance"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "display_name": { "type": "string", "maxLength": 256 },
        "provenance": { "type": "string", "enum": ["simulated", "replayed", "manual"] },
        "attributes": { "type": "object" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "type", "to", "valid_from", "provenance"],
      "properties": {
        "from": { "type": "string" },
        "type": { "type": "string" },
        "to": { "type": "string" },
        "valid_from": { "$ref": "#/$defs/offset" },
        "valid_to": { "oneOf": [{ "$ref": "#/$defs/offset" }, { "type": "null" }] },
        "provenance": { "type": "string", "enum": ["simulated", "replayed", "manual"] }
      }
    },
    "metricPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "value"],
      "properties": {
        "offset": { "$ref": "#/$defs/offset" },
        "value": { "type": "number" }
      }
    },
    "metricFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_ref", "metric", "points", "provenance"],
      "properties": {
        "resource_ref": { "type": "string" },
        "metric": { "type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metricPoint" } },
        "provenance": { "type": "string", "enum": ["simulated", "replayed"] }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target_ref"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["set_memory_limit", "set_cpu_quota", "set_tool_behavior", "start_cpu_load", "stop_cpu_load", "restore_snapshot", "restart_test_container"]
        },
        "target_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parameters": { "type": "object", "maxProperties": 16 }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "expected"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "operator": { "type": "string", "enum": ["equals", "not_equals", "contains", "exists", "count_equals", "less_than", "greater_than"] },
        "expected": {}
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "fault" } } },
      "then": { "required": ["inject", "restore"] }
    }
  ]
}
