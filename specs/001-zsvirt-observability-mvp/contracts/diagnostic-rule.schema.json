{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layertrace.local/schemas/diagnostic-rule-1.0.json",
  "title": "LayerTrace Diagnostic Rule 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_id", "version", "title", "symptoms", "window", "evaluator", "recommendations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "rule_id": { "type": "string", "pattern": "^R(?:0|[1-9][0-9]*)$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "enabled": { "type": "boolean", "default": true },
    "symptoms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_seconds", "after_seconds"],
      "properties": {
        "before_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "after_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 }
      }
    },
    "thresholds": { "type": "object", "additionalProperties": { "type": ["number", "integer", "string", "boolean"] } },
    "relationship_paths": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
    },
    "required_signals": { "type": "array", "items": { "type": "string" } },
    "evaluator": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "recommendations": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 1000 } },
    "verification_steps": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
  }
}
